    {
      "name": "00 — HomeSpace: gộp 10 categorySet, bán kính 2 km",
      "description": "Luồng backend hiện tại: một request gộp OR, limit=100, ofs=0. Lưu các kết quả thực nhận sau chống trùng; không gọi trang tiếp hoặc gọi bù nhóm còn thiếu. Không tự chạy Runner.",
      "item": [
        {
          "name": "01 Nearby gộp 10 loại — một request, tối đa 100 kết quả",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/2/nearbySearch/.json?key={{TOMTOM_API_KEY}}&lat={{lat}}&lon={{lon}}&radius=2000&limit=100&ofs=0&countrySet=VN&categorySet={{categorySetBatch}}",
              "host": ["{{baseUrl}}"],
              "path": ["search", "2", "nearbySearch", ".json"],
              "query": [
                {"key": "key", "value": "{{TOMTOM_API_KEY}}"},
                {"key": "lat", "value": "{{lat}}"},
                {"key": "lon", "value": "{{lon}}"},
                {"key": "radius", "value": "2000"},
                {"key": "limit", "value": "100"},
                {"key": "ofs", "value": "0"},
                {"key": "countrySet", "value": "VN"},
                {"key": "categorySet", "value": "{{categorySetBatch}}"}
              ]
            }
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) { const s = pm.response.json().summary; pm.collectionVariables.set('nearbyReturned', s.numResults); pm.collectionVariables.set('nearbyTotalReported', s.totalResults); pm.test('At most 100 results from offset zero', () => { pm.expect(s.numResults).to.be.at.most(100); pm.expect(s.offset).to.equal(0); }); }"
          ]}}]
        }
      ]
    },
    {
      "name": "01 — Tra cứu danh mục đầy đủ (1 request)",
      "item": [
        {
          "name": "01 GET Toàn bộ CategorySet ID + tên + mã con",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search/2/poiCategories.json?key={{TOMTOM_API_KEY}}&language={{categoryLanguage}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search",
                "2",
                "poiCategories.json"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{TOMTOM_API_KEY}}"
                },
                {
                  "key": "language",
                  "value": "{{categoryLanguage}}"
                }
              ]
            },
            "description": "Nguồn DUY NHẤT để lấy hết categories trong tài khoản của bạn. Sau Send, xem tab Visualize để duyệt đầy đủ và chọn Save Response để xuất JSON. Không dùng code 4 chữ số từ classifications (chuỗi)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const payload = pm.response.json();",
                  "  const roots = payload.poiCategories;",
                  "  pm.test(\"Danh mục poiCategories[]\", () => pm.expect(roots).to.be.an(\"array\"));",
                  "  if (Array.isArray(roots)) {",
                  "    const found = new Map();",
                  "    roots.forEach(c => {",
                  "      if (c && Number.isFinite(Number(c.id))) {",
                  "        const id = String(c.id);",
                  "        const old = found.get(id) || {};",
                  "        found.set(id, { id, name: c.name || old.name || \"\", children: (c.childCategoryIds || []).length, type: \"category\" });",
                  "        (c.childCategoryIds || []).forEach(n => {",
                  "          const key = String(n);",
                  "          if (!found.has(key)) found.set(key, {id:key, name:\"(child: xem danh mục chi tiết)\", children:0, type:\"child ID\"});",
                  "        });",
                  "      }",
                  "    });",
                  "    const all = Array.from(found.values()).sort((a,b) => Number(a.id)-Number(b.id));",
                  "    pm.collectionVariables.set(\"categoryCountLastLoaded\", String(all.length));",
                  "    console.log(\"TomTom category entries:\", roots.length, \"distinct IDs (incl. child IDs):\", all.length);",
                  "    console.log(\"First 25:\", JSON.stringify(all.slice(0,25)));",
                  "    const template = `<style>body{font:14px system-ui;padding:10px}table{border-collapse:collapse;width:100%}th,td{padding:7px;border-bottom:1px solid #ddd;text-align:left}th{position:sticky;top:0;background:#f5f5f5}small{color:#666}</style><h2>Toàn bộ mã TomTom trả về</h2><p>{{num}} mã riêng biệt (bao gồm child IDs), {{parentNum}} đối tượng poiCategories[]. Để xuất đầy đủ, Save Response → JSON rồi chạy script kèm theo.</p><table><thead><tr><th>Mã</th><th>Tên</th><th>Loại</th><th>Số mã con</th></tr></thead><tbody>{{#each rows}}<tr><td><code>{{id}}</code></td><td>{{name}}</td><td>{{type}}</td><td>{{children}}</td></tr>{{/each}}</tbody></table>`;",
                  "    pm.visualizer.set(template, {num:all.length,parentNum:roots.length,rows:all});",
                  "  }",
                  "}",
                  ""
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
