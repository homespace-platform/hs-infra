    {
      "name": "Admin Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('user accepted for provisioning', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.result.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.result.provisioningStatus).to.eql('PROVISIONING');",
                  "});",
                  "if (body.result?.id) pm.collectionVariables.set('createdUserId', body.result.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminCreateUsername}}\",\n  \"email\": \"{{adminCreateEmail}}\",\n  \"firstName\": \"System\",\n  \"lastName\": \"User\",\n  \"phone\": \"{{adminCreatePhone}}\",\n  \"enabled\": true,\n  \"sendInvitation\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "description": "Creates the account in Keycloak. Keycloak events then provision the database record through Kafka. When enabled, invitation email requests email verification and password setup."
          },
          "response": []
        },
        {
          "name": "List Users - Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const page = body.result;",
                  "pm.test('paged users returned', () => {",
                  "  pm.expect(page.result).to.be.an('array');",
                  "  pm.expect(page.page).to.be.a('number');",
                  "  pm.expect(page.totalElements).to.be.a('number');",
                  "});",
                  "if (page.result?.[0]?.id) pm.collectionVariables.set('userId', page.result[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=0&size=10&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Spring request page index is zero-based."
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            },
            "description": "Returns a paginated list of users. Response PageResponse.page is one-based."
          },
          "response": []
        },
        {
          "name": "Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('full user profile returned', () => {",
                  "  pm.expect(body.result.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(body.result).to.include.keys('id', 'username', 'email', 'firstName', 'lastName', 'avatarUrl', 'avatarStorageId', 'phone', 'dob', 'gender', 'roleId', 'role', 'onBoarded', 'active', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy');",
                  "  ['createdBy', 'updatedBy'].forEach((field) => {",
                  "    const actor = body.result[field];",
                  "    if (actor) {",
                  "      pm.expect(actor).to.include.keys('id', 'fullName', 'username', 'phone', 'email');",
                  "    }",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Returns all persisted profile fields for a user. Requires ADMIN authority."
          },
          "response": []
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('user updated', () => {",
                  "  pm.expect(body.result.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(body.result.firstName).to.eql('Van Minh');",
                  "  pm.expect(body.result.gender).to.eql('MALE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminCreateUsername}}\",\n  \"email\": \"{{adminCreateEmail}}\",\n  \"firstName\": \"Van Minh\",\n  \"lastName\": \"Nguyen\",\n  \"phone\": \"{{adminCreatePhone}}\",\n  \"dob\": \"2000-08-06\",\n  \"gender\": \"MALE\",\n  \"roleId\": \"{{roleId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Updates the profile of any user by ID. Requires ADMIN plus USER_UPDATE authority.\n\nAccepts username, email, firstName, lastName, phone, dob, gender and roleId. All fields are optional and omitted or blank fields keep their current value, so this doubles as a partial update.\n\nusername, email, firstName, lastName and phone are pushed to Keycloak and mirrored back through the Kafka sync. dob, gender and role exist only in the database.\n\nYou cannot change your own roleId (code 2018).\n\nHandled by dedicated endpoints instead: account status through Enable / Disable User, onboarding through Onboarding Me, and the avatar through the storage upload flow at PUT /users/me/avatar. id and the audit columns are managed by the system.\n\nChanging the email resets Keycloak email verification, so follow it with Resend Invitation."
          },
          "response": []
        },
        {
          "name": "Disable User",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/disable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "disable"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Enable User",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/enable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "enable"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Resend Invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/resend-invitation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "resend-invitation"
              ]
            },
            "description": "Sends a new Keycloak execute-actions email (verify email + set password). The previous 12-hour action link is replaced. The user must be enabled. Fails if the account already completed those actions."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Roles",
      "item": [
        {
          "name": "List Roles - Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const roles = body.result?.result || body.result || [];",
                  "const target = roles.find(r => r.name === pm.collectionVariables.get('roleName')) || roles.find(r => r.name === 'ADMIN') || roles[0];",
                  "if (target?.id) pm.collectionVariables.set('roleId', target.id);",
                  "pm.test('roleId saved when roles exist', () => pm.expect(pm.collectionVariables.get('roleId')).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/roles?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "roles"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "includePermissions",
                  "value": "true",
                  "disabled": true,
                  "description": "Set true to embed each role's permissions. Default is false / omitted."
                }
              ]
            },
            "description": "Paged role list. Permissions are omitted unless includePermissions=true."
          },
          "response": []
