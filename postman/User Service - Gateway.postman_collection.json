              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const previous = pm.collectionVariables.get('oldPassword');",
                  "  const current = pm.collectionVariables.get('newPassword');",
                  "  pm.collectionVariables.set('oldPassword', current);",
                  "  pm.collectionVariables.set('newPassword', previous);",
                  "  pm.collectionVariables.set('password', current);",
                  "  pm.test('login password rotated', () => pm.expect(pm.collectionVariables.get('password')).to.eql(current));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"{{oldPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "password"
              ]
            },
            "description": "On success the collection swaps oldPassword and newPassword and points the login password at the new value, so Get Token keeps working without editing variables."
          },
          "response": []
        },
        {
          "name": "Get Password Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('password status is boolean', () => pm.expect(body.result).to.be.a('boolean'));",
                  "pm.collectionVariables.set('hasPassword', String(body.result));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/password/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "password",
                "status"
              ]
            },
            "description": "Returns result=true when the current Keycloak account has a password credential; otherwise returns false."
          },
          "response": []
        },
