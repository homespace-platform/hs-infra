@startuml Hinh_3_27_ERD_Audit_Service_DeXuat
' Mục 3.4.2 - THIẾT KẾ ĐỀ XUẤT, chưa có entity Audit Service tương ứng trong mã nguồn. audit_event là sự kiện chung; hai bảng còn lại là thông tin mở rộng tùy loại.
' Các trường chính được rút gọn. FK là quan hệ JPA; REF là ID tham chiếu logic.
' Không có tiêu đề và chú giải ở dưới theo yêu cầu.
top to bottom direction

hide circle
hide methods
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 200
scale 0.8
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam defaultFontStyle bold
skinparam classFontSize 16
skinparam classFontStyle bold
skinparam classAttributeFontSize 14
skinparam classAttributeFontStyle bold
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50
skinparam roundcorner 0

entity "audit_event" as Audit <<dự kiến>> {
    * id : uuid <<PK>>
    --
    * event_id : uuid <<UK>>
    * event_type : varchar
    * source_service : varchar
    actor_id : varchar <<REF>>
    aggregate_type : varchar
    aggregate_id : varchar <<REF>>
    correlation_id : varchar
    * occurred_at : timestamptz
    metadata : jsonb
}

entity "security_event" as Security <<dự kiến>> {
    * id : uuid <<PK>>
    --
    * audit_event_id : uuid <<FK, UK>>
    * action : varchar
    * outcome : varchar
    client_id : varchar
    ip_address : inet
    reason : text
}

entity "access_record" as Access <<dự kiến>> {
    * id : uuid <<PK>>
    --
    * audit_event_id : uuid <<FK, UK>>
    * resource_type : varchar
    * resource_id : varchar <<REF>>
    http_method : varchar
    response_status : integer
    * accessed_at : timestamptz
}


Audit ||--o| Security
Audit ||--o| Access

@enduml

