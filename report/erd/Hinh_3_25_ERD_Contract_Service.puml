@startuml Hinh_3_25_ERD_Contract_Service
' Mục 3.4.2 - Một ERD chung cho Contract Service, gộp hai phần trước.
' Nguồn: hs-core-api/hs-contract-service/src/main/java/com/hs/contract/model.
' Giữ các trường và quan hệ chính để 11 bảng có thể đặt trong cùng một hình.
' Các ID scalar là REF, không tự biến thành FK. Không có tiêu đề/chú giải bên dưới.

top to bottom direction
hide circle
hide methods
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam dpi 200
scale 0.8
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam defaultFontStyle bold
skinparam classFontSize 16
skinparam classFontStyle bold
skinparam classAttributeFontSize 14
skinparam classAttributeFontStyle bold
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam roundcorner 0

entity "contract_templates" as Template {
    * id : varchar <<PK>>
    --
    * name : varchar
    * category : varchar <<UK>>
    * source : varchar
    * status : varchar
}

entity "contract_template_versions" as TemplateVersion {
    * id : varchar <<PK>>
    --
    * template_id : varchar <<FK>>
    * version_number : integer
    * storage_object_id : varchar <<REF>>
    * status : varchar
    --
    UNIQUE(template_id, version_number)
}

entity "contracts" as Contract {
    * id : varchar <<PK>>
    --
    * contract_number : varchar <<UK>>
    * rental_request_id : varchar <<REF>>
    * listing_id : varchar <<REF>>
    * landlord_id : varchar <<REF>>
    * tenant_id : varchar <<REF>>
    * template_version_id : varchar <<REF>>
    current_revision_id : varchar <<REF>>
    parent_contract_id : varchar <<REF>>
    * status : varchar
}

entity "contract_revisions" as Revision {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<FK>>
    * revision_number : integer
    * landlord_snapshot : text
    * tenant_snapshot : text
    * property_snapshot : text
    * lease_snapshot : text
    * financial_snapshot : text
    --
    UNIQUE(contract_id, revision_number)
}

entity "contract_documents" as Document {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<REF>>
    * revision_id : varchar <<REF>>
    * document_type : varchar
    * purpose : varchar
    storage_object_id : varchar <<REF>>
    * status : varchar
}

entity "signature_requests" as Signature {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<REF>>
    * revision_id : varchar <<REF>>
    * source_document_id : varchar <<REF>>
    signed_document_id : varchar <<REF>>
    * signer_user_id : varchar <<REF>>
    * signer_role : varchar
    * status : varchar
    provider_tran_code : varchar
}

entity "monthly_invoices" as Invoice {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<REF>>
    * period_index : integer
    * total_amount : numeric
    payment_request_id : varchar <<REF>>
    * status : varchar
    due_at : timestamptz
    --
    UNIQUE(contract_id, period_index)
}

entity "contract_amendments" as Amendment {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<REF>>
    * base_revision_id : varchar <<REF>>
    agreement_contract_id : varchar <<UK, REF>>
    * effective_on : date
    * changes_snapshot : text
    * status : varchar
}

entity "contract_amendment_drafts" as Draft {
    * contract_id : varchar <<PK, REF>>
    --
    * owner_id : varchar <<REF>>
    * payload : text
}

entity "contract_renewals" as Renewal {
    * id : varchar <<PK>>
    --
    * contract_id : varchar <<REF>>
    agreement_contract_id : varchar <<REF>>
    * months : integer
    starts_on : date
    end_exclusive : date
    * status : varchar
}

entity "contract_closures" as Closure {
    * contract_id : varchar <<PK, REF>>
    --
    * status : varchar
    refund_amount : numeric
    balance_amount : numeric
    refund_payment_id : varchar <<REF>>
    balance_payment_id : varchar <<REF>>
    closed_at : timestamptz
}

Template ||-right-o{ TemplateVersion
TemplateVersion ||-[dashed]down-o{ Contract
Contract ||-left-o{ Revision
Revision ||-[dashed]down-o{ Document
Document ||-[dashed]down-o{ Signature
Contract ||-[dashed]right-o{ Invoice
Contract ||-[dashed]up-o{ Amendment
Contract ||-[dashed]right-o| Draft
Contract ||-[dashed]down-o{ Renewal
Contract ||-[dashed]down-o| Closure

@enduml
