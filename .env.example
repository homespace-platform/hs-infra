# PostgreSQL / Keycloak database
POSTGRES_DB=keycloak
POSTGRES_USER=homespace
POSTGRES_PASSWORD=homespace123

POSTGRES_AI_DB=homespace_ai
POSTGRES_AI_USER=homespace
POSTGRES_AI_PASSWORD=homespace123

# MongoDB
# MONGO_INITDB_DATABASE is a database name, not an account.
# The root user is always created in the "admin" database.
MONGO_INITDB_ROOT_USERNAME=homespace
MONGO_INITDB_ROOT_PASSWORD=homespace123
MONGO_INITDB_DATABASE=admin

# Redis
REDIS_PASSWORD=homespace123

# pgAdmin
PGADMIN_DEFAULT_EMAIL=zolaracskh@gmail.com
PGADMIN_DEFAULT_PASSWORD=homespace123

# Keycloak
KEYCLOAK_ADMIN_USERNAME=homespace
KEYCLOAK_ADMIN_PASSWORD=homespace123
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_HOSTNAME_STRICT=false

# Kafka / Keycloak SPI
KAFKA_BOOTSTRAP_SERVER=kafka:19092
KEYCLOAK_KAFKA_TOPIC=keycloak-user-events
KAFKA_EVENTS_TOPIC=homespace.notification.events.v1
KAFKA_DLT_TOPIC=homespace.notification.events.dlt.v1
