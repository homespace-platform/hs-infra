FROM quay.io/keycloak/keycloak:26.5.2 AS build
ENV KC_DB=postgres KC_HEALTH_ENABLED=true
COPY --chown=1000:0 --chmod=0644 provider/*.jar /opt/keycloak/providers/
COPY --chown=1000:0 keycloak-themes/ /opt/keycloak/themes/
RUN touch -m --date=@1743465600 /opt/keycloak/providers/*.jar \
    && /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.5.2
ENV KC_DB=postgres KC_HEALTH_ENABLED=true
COPY --from=build --chown=1000:0 /opt/keycloak/ /opt/keycloak/
COPY --chown=1000:0 --chmod=0644 realm-export.json /opt/keycloak/data/import/homespace-platform-realm.json
